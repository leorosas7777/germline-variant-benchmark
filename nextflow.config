params {
    sample   = 'HG002'
    reads_r1 = null
    reads_r2 = null
    fasta    = null
    outdir   = 'results'
}

process {
    shell  = ['/bin/bash', '-euo', 'pipefail']
    cpus   = 2
    memory = '4 GB'
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    test {
        includeConfig 'conf/test.config'
    }
}
