params {
    sample          = 'HG002'
    reads_r1        = null
    reads_r2        = null
    fasta           = null
    calling_regions = null   // null = whole FASTA; format chr:start-end
    truth_vcf           = null   // GIAB truth VCF (.vcf.gz + .tbi alongside)
    truth_bed           = null   // GIAB benchmark regions BED
    stratifications_tsv = null   // hap.py stratification TSV; BED paths relative to it
    outdir          = 'results'
}

process {
    shell  = ['/bin/bash', '-euo', 'pipefail']
    cpus   = 2
    memory = '4 GB'
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    test {
        includeConfig 'conf/test.config'
    }
}
