params {
    reads_r1        = "${projectDir}/data/ci/HG002_ci_R1.fastq.gz"
    reads_r2        = "${projectDir}/data/ci/HG002_ci_R2.fastq.gz"
    fasta           = "${projectDir}/data/ci/chr20.fa"
    calling_regions = 'chr20:10000000-11000000'
    outdir          = 'results_test'
}

process {
    resourceLimits = [cpus: 2, memory: '3 GB']
}
